# Public, local-only evaluation settings. These values are intentionally not
# production secrets. Copy this file to compose.local.env before running the
# compose commands in README.md; compose.local.env is ignored by Git.
STUDYNOTION_WEB_PORT=3000
STUDYNOTION_API_PORT=4000
STUDYNOTION_LOCAL_JWT_SECRET=local-only-jwt-secret-for-container-evaluation
STUDYNOTION_LOCAL_OTP_SECRET=local-only-otp-secret-for-container-evaluation
STUDYNOTION_LOCAL_ENTITLEMENT_SIDECAR_STARTED_AT=2026-08-24T00:00:00.000Z
STUDYNOTION_DEMO_ADMIN_EMAIL=admin@studynotion.local
STUDYNOTION_DEMO_ADMIN_PASSWORD=Admin@123
STUDYNOTION_DEMO_INSTRUCTOR_EMAIL=instructor@studynotion.local
STUDYNOTION_DEMO_INSTRUCTOR_PASSWORD=Instructor@123
STUDYNOTION_DEMO_STUDENT_EMAIL=student@studynotion.local
STUDYNOTION_DEMO_STUDENT_PASSWORD=Student@123
