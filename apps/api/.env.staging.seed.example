# One-shot overlay for an isolated interview/demo seed job only. Combine it
# with the staging runtime secret for that job, then rotate/remove every value.
# Never mount this overlay into the API or Entitlement recovery workload.
STUDYNOTION_DEMO_SEED_MODE=staging
STUDYNOTION_DISPOSABLE_SEED_CONFIRM=
STUDYNOTION_DEMO_ADMIN_EMAIL=
STUDYNOTION_DEMO_ADMIN_PASSWORD=
STUDYNOTION_DEMO_INSTRUCTOR_EMAIL=
STUDYNOTION_DEMO_INSTRUCTOR_PASSWORD=
STUDYNOTION_DEMO_STUDENT_EMAIL=
STUDYNOTION_DEMO_STUDENT_PASSWORD=
STUDYNOTION_DEMO_VIDEO_PUBLIC_ID=
STUDYNOTION_DEMO_VIDEO_FORMAT=mp4
