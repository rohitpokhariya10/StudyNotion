{
  "name": "studynotion-web",
  "version": "0.1.0",
  "description": "StudyNotion React web application",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-public-env.mjs && vite build",
    "build:local": "vite build",
    "nginx:render": "node scripts/render-nginx-config.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@ramonak/react-progress-bar": "^5.0.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@studynotion/contracts": "0.1.0",
    "axios": "^1.20.0",
    "chart.js": "^4.3.0",
    "copy-to-clipboard": "^4.0.2",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.86.0",
    "react-hot-toast": "^2.4.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "react-super-responsive-table": "^5.2.1",
    "react-type-animation": "^3.0.1",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
