# Public browser configuration for the same-origin HTTPS staging deployment.
# This file contains no secrets. Replace every placeholder before building.
VITE_DEPLOYMENT_TIER=staging
VITE_API_BASE_URL=/api/v1

# Optional in staging. Leave blank to hide Google sign-in, or use a dedicated
# staging OAuth Web Client ID with the staging origin registered.
VITE_GOOGLE_CLIENT_ID=

# Public staging must use Razorpay test mode. Never put a secret in VITE_*.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me

VITE_SUPPORT_EMAIL=support@example.com
VITE_LEGAL_ENTITY_NAME=REPLACE_WITH_REGISTERED_ENTITY
VITE_LEGAL_ADDRESS=REPLACE_WITH_REGISTERED_ADDRESS
VITE_LEGAL_JURISDICTION=India
