{
  "name": "studynotion-client",
  "description": "StudyNotion full-stack MERN learning platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "server"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "@ramonak/react-progress-bar": "^5.0.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@studynotion/contracts": "0.1.0",
    "axios": "^1.3.5",
    "chart.js": "^4.3.0",
    "copy-to-clipboard": "^4.0.2",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.43.9",
    "react-hot-toast": "^2.4.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "react-super-responsive-table": "^5.2.1",
    "react-type-animation": "^3.0.1",
    "swiper": "^14.0.5"
  },
  "scripts": {
    "start": "vite",
    "client": "vite",
    "build": "node scripts/validate-public-env.mjs && vite build",
    "build:local": "vite build",
    "e2e:serve": "npm run build:local && npm run preview -- --host 127.0.0.1 --port 4173",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.mjs",
    "test:integration": "npm run test:integration --workspace studynotion-backend",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json",
    "contracts:generate": "npm run openapi:generate --workspace @studynotion/contracts",
    "contracts:openapi:check": "npm run openapi:check --workspace @studynotion/contracts",
    "contracts:test": "npm run test --workspace @studynotion/contracts",
    "architecture:check": "node scripts/check-architecture.mjs",
    "deploy:validate-pair": "node scripts/validate-release-pair.mjs",
    "ops:validate-image": "node scripts/validate-image-reference.mjs",
    "ops:validate-recovery-host": "node scripts/validate-recovery-host.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && npm run architecture:check",
    "verify": "npm run contracts:openapi:check && npm run contracts:test && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:local && npm --workspace studynotion-backend test",
    "server": "cd server && npm run dev",
    "dev": "concurrently -n \"client,server\" -c \"bgBlue,bgYellow\" \"npm run client\" \"npm run server\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tldts": "^7.4.9",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
