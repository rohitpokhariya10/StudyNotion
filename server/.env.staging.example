# Production-style runtime configuration for the isolated staging environment.
NODE_ENV=production
DEPLOYMENT_TIER=staging
LOG_LEVEL=info
PORT=4000

# Use dedicated HTTPS staging hosts. APP_URL must appear in FRONTEND_ORIGINS.
FRONTEND_ORIGINS=https://staging.example.com
APP_URL=https://staging.example.com
PUBLIC_API_URL=https://api.staging.example.com
BRAND_NAME=StudyNotion Staging
BRAND_LOGO_URL=https://staging.example.com/logo.png
SUPPORT_EMAIL=support@example.com

# Never point staging at production data or caches.
# Include the isolated staging database and durable write concern, for example:
# mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://replace-with-staging-secret-manager-value?retryWrites=true&w=majority
REDIS_URL=rediss://default:replace-with-staging-secret@redis.staging.example.net:6379
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
JWT_SECRET=replace-with-at-least-32-random-staging-characters
OTP_SECRET=replace-with-a-different-32-character-staging-secret
ALLOW_DEV_OTP=false

TRUST_PROXY=1
JSON_BODY_LIMIT=100kb
FORM_BODY_LIMIT=100kb
UPLOAD_MAX_BYTES=26214400
REQUEST_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_OPERATION_TIMEOUT_MS=15000
MONGODB_SOCKET_TIMEOUT_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
MONGODB_AUTO_INDEX=false

COOKIE_NAME=studynotion_staging_session
# Prefer a host-only staging cookie. If set, COOKIE_DOMAIN must contain both
# APP_URL and PUBLIC_API_URL hostnames.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

# Optional in staging. Leave blank together with VITE_GOOGLE_CLIENT_ID to hide
# Google sign-in, or use a dedicated staging Web Client ID.
GOOGLE_CLIENT_ID=

# Use a sandbox/test sender and staging recipient.
RESEND_API_KEY=re_replace_with_staging_key
EMAIL_FROM=StudyNotion Staging <noreply@example.com>
EMAIL_REPLY_TO=support@example.com
CONTACT_RECIPIENT=staging-inbox@example.com

# Staging is test-mode only. Never put live Razorpay credentials here.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_SECRET=replace-with-staging-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-staging-webhook-secret

# Keep staging uploads isolated from production media.
CLOUD_NAME=replace-with-staging-cloud
CLOUD_API_KEY=replace-with-staging-api-key
CLOUD_API_SECRET=replace-with-staging-api-secret
FOLDER_NAME=studynotion-staging
MEDIA_URL_TTL_SECONDS=3600
CHECKOUT_TTL_SECONDS=1800
RAZORPAY_TIMEOUT_MS=10000
GOOGLE_TIMEOUT_MS=10000
REFUND_WINDOW_DAYS=7

# Pin one reviewed UTC boundary for the staging rehearsal and keep it stable.
ENTITLEMENT_SIDECAR_STARTED_AT=
